#!/bin/sh
# trimAl for the Mac this runs on: the arm64 build (bioconda trimAl 1.5.1)
# on Apple silicon, the x86_64 build on Intel Macs.
here=$(cd "$(dirname "$0")" && pwd)
if [ "$(uname -m)" = "arm64" ] && [ -x "$here/trimal-arm64" ]; then
  exec "$here/trimal-arm64" "$@"
fi
exec "$here/trimal-x86_64" "$@"
