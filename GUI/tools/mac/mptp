#!/bin/sh
# mPTP for the Mac this runs on: the official arm64 build (v0.2.5) on Apple
# silicon, the official x86_64 build (v0.2.4, the last one for Intel Macs)
# on Intel Macs.
here=$(cd "$(dirname "$0")" && pwd)
if [ "$(uname -m)" = "arm64" ] && [ -x "$here/mptp-arm64" ]; then
  exec "$here/mptp-arm64" "$@"
fi
exec "$here/mptp-x86_64" "$@"
